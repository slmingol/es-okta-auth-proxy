# Okta OIDC
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-client-secret
# Must match Okta app's redirect URI setting
OKTA_REDIRECT_URI=http://localhost:3000/auth/callback

# Elasticsearch
ES_URL=https://your-es-host:9200
ES_API_KEY=your-base64-encoded-api-key

# Session
SESSION_SECRET=change-this-to-something-random
PORT=3000
