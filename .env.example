# Okta OIDC app credentials
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=0oaXXXXXXXXXXXXXX
OKTA_CLIENT_SECRET=your-client-secret
OKTA_REDIRECT_URI=http://localhost:3344/auth/callback

# Elasticsearch
ES_URL=https://your-es-cluster:9200
# Set to 'mock' to run without a real ES cluster
# ES_URL=mock

# Fallback ES API key (base64 encoded id:api_key) used when no group map is loaded
ES_API_KEY=

# Express session signing secret -- use a long random string
SESSION_SECRET=change-me-to-something-random-and-long

# Port the proxy listens on (default: 3344)
PORT=3344

# --- Optional: group-based API key mapping ---
# Path to group-map.json (default: ./config/group-map.json)
# GROUP_MAP_PATH=./config/group-map.json

# --- Optional: built-in key rotation ---
# Basic auth credentials as user:password (recommended over ES_ROTATION_KEY)
# ES_ROTATION_CREDS=elastic:your-password
# ES_ROTATION_KEY=base64-encoded-id:api_key
# KEY_ROTATION_HOURS=24

# Set to 'false' to skip TLS verification for rotation calls
# ES_TLS_VERIFY=true
