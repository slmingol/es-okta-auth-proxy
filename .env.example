# Okta OIDC — OKTA_DOMAIN must be bare hostname, no scheme or trailing slash
# Uses /oauth2/default auth server — org auth server is not supported
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=0oaXXXXXXXXXXXXXX
OKTA_CLIENT_SECRET=your-client-secret
# Must exactly match the Sign-in redirect URI configured in Okta
OKTA_REDIRECT_URI=http://localhost:3344/auth/callback
# Optional: redirect here after Okta SSO logout (must be in Okta Sign-out redirect URIs)
# OKTA_POST_LOGOUT_URI=http://localhost:3344

# Elasticsearch
ES_URL=https://your-es-cluster:9200
# Set to 'mock' to run without a real ES cluster (Okta still required)
# ES_URL=mock

# Fallback ES API key — base64(id:api_key) — used when no group map entry matches
ES_API_KEY=

# Set to 'false' to skip TLS verification (self-signed certs, ECK)
# Affects both proxy and rotation calls
# ES_TLS_VERIFY=false

# Session signing secret — use a long random string: openssl rand -hex 32
SESSION_SECRET=change-me-to-something-long-and-random

# Port the proxy listens on (default: 3344)
PORT=3344

# Set to 'true' when running behind HTTPS (required for secure cookies in production)
# COOKIE_SECURE=true

# --- Optional: group-based API key mapping ---
# Path to group-map.json (default: ./config/group-map.json)
# GROUP_MAP_PATH=./config/group-map.json

# --- Optional: Kibana reverse proxy ---
# Enables /kibana/* proxy and /kibana-user.js identity banner
# KIBANA_URL=http://kibana:5601

# --- Optional: built-in key rotation ---
# Basic auth as user:password — needs manage_api_key cluster privilege (recommended)
# ES_ROTATION_CREDS=elastic:your-password
# API key alternative — derived keys cannot use manage_api_key, not recommended
# ES_ROTATION_KEY=base64-encoded-id:api_key
# Rotate every N hours (omit or 0 to disable)
# KEY_ROTATION_HOURS=24
