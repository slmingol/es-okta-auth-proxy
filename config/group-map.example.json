{
  "_comment": "Maps Okta group names to ES API keys (base64 encoded id:api_key). First matching group wins. '_default' used when no group matches. '_roles' enables built-in key rotation (requires ES_ROTATION_KEY + KEY_ROTATION_HOURS).",
  "_priority": ["es-admin", "es-metrics-write", "es-metrics-read", "es-readonly"],
  "_roles": {
    "es-admin": {
      "cluster": ["all"],
      "indices": [{ "names": ["*"], "privileges": ["all"] }]
    },
    "es-metrics-write": {
      "cluster": ["monitor"],
      "indices": [{ "names": ["metrics-*"], "privileges": ["read", "write", "view_index_metadata"] }]
    },
    "es-metrics-read": {
      "cluster": ["monitor"],
      "indices": [{ "names": ["metrics-*"], "privileges": ["read", "view_index_metadata"] }]
    },
    "es-readonly": {
      "cluster": ["monitor"],
      "indices": [{ "names": ["*"], "privileges": ["read", "view_index_metadata"] }]
    }
  },
  "es-admin": "BASE64_APIKEY_FOR_ES_ADMIN",
  "es-metrics-write": "BASE64_APIKEY_FOR_METRICS_WRITE",
  "es-metrics-read": "BASE64_APIKEY_FOR_METRICS_READ",
  "es-readonly": "BASE64_APIKEY_FOR_READONLY",
  "_default": "BASE64_APIKEY_FALLBACK"
}
